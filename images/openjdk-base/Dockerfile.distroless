# syntax=docker/dockerfile:1@sha256:2780b5c3bab67f1f76c781860de469442999ed1a0d7992a5efdf2cffc0e3d769
# OpenJDK on Wolfi — distroless variant (JRE only, no shell, no Maven).
# Use as the final runtime stage in multi-stage Dockerfiles.
FROM cgr.dev/chainguard/jre:latest@sha256:ae2278961aa50ce0e7f1e716647fee110df0d53c3689c17f7b13b85d966d3df6

ARG BUILD_DATE
ARG GIT_REVISION
ARG IMAGE_VERSION=dev

LABEL org.opencontainers.image.source="https://github.com/platform-base-images/hardened-base"
LABEL org.opencontainers.image.version="${IMAGE_VERSION}-distroless"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_REVISION}"
LABEL org.opencontainers.image.licenses="Apache-2.0"

ENV JAVA_TOOL_OPTIONS="-Djava.security.egd=file:/dev/./urandom -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

WORKDIR /app

# chainguard/jre doesn't create a "nonroot" account like Chainguard's other
# images (python, node, wolfi-base) do — its non-root user is named "java"
# (still uid/gid 65532). USER nonroot here fails at container-start time with
# "unable to find user nonroot: no matching entries in passwd file", not at
# build time, so it was never caught until a real consumer tried to run the
# published image (platform-base-images/app-reference-implementations#136).
USER java
